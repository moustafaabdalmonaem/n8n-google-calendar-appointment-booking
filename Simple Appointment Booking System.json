    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "aa000000-0000-4000-8000-000000000001",
              "name": "customerName",
              "value": "={{ $json.body.name }}",
              "type": "string"
            },
            {
              "id": "aa000000-0000-4000-8000-000000000002",
              "name": "customerEmail",
              "value": "={{ $json.body.email }}",
              "type": "string"
            },
            {
              "id": "aa000000-0000-4000-8000-000000000003",
              "name": "requestedStart",
              "value": "={{ $json.body.startTime }}",
              "type": "string"
            },
            {
              "id": "aa000000-0000-4000-8000-000000000004",
              "name": "requestedEnd",
              "value": "={{ $json.body.endTime }}",
              "type": "string"
            },
            {
              "id": "aa000000-0000-4000-8000-000000000005",
              "name": "serviceType",
              "value": "={{ $json.body.service }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b4312156-cad0-4b0a-a8be-19e3e4625547",
      "name": "Extract Booking Details",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -800,
        128
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "PUT_YOUR_GOOGLE_CALENDAR_ID_HERE",
          "mode": "id"
        },
        "timeMin": "={{ $json.requestedStart }}",
        "timeMax": "={{ $json.requestedEnd }}",
        "options": {}
      },
      "id": "2dcb456a-1bcd-4468-9af0-9e1bb246c41e",
      "name": "Check Calendar for Conflicts",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        -592,
        -48
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cc000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $items(\"Check Calendar for Conflicts\").length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "33bdde5d-6de3-4955-8e4f-5294fd49209d",
      "name": "Is Time Slot Free?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -336,
        96
      ]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "PUT_YOUR_GOOGLE_CALENDAR_ID_HERE",
          "mode": "id"
        },
        "start": "={{ $('Extract Booking Details').item.json.requestedStart }}",
        "end": "={{ $('Extract Booking Details').item.json.requestedEnd }}",
        "additionalFields": {
          "description": "Booked automatically. Customer email: {{ $('Extract Booking Details').item.json.customerEmail }}",
          "summary": "={{ $('Extract Booking Details').item.json.serviceType }} - {{ $('Extract Booking Details').item.json.customerName }}"
        }
      },
      "id": "b77c621b-a5cf-4c98-8d0e-37a10831e60b",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        -96,
        -112
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Extract Booking Details').item.json.customerEmail }}",
        "subject": "Your appointment is confirmed!",
        "message": "Hi {{ $('Extract Booking Details').item.json.customerName }},\n\nYour appointment for \"{{ $('Extract Booking Details').item.json.serviceType }}\" is confirmed for:\n{{ $('Extract Booking Details').item.json.requestedStart }} - {{ $('Extract Booking Details').item.json.requestedEnd }}\n\nSee you then!",
        "options": {}
      },
      "id": "c587c705-fa50-4c82-91dd-b829caada9c5",
