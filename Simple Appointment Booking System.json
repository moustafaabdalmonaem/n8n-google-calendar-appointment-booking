    },
    {
      "parameters": {
        "sendTo": "={{ $('Extract Booking Details').item.json.customerEmail }}",
        "subject": "Sorry, that time slot is not available",
        "message": "Hi {{ $('Extract Booking Details').item.json.customerName }},\n\nUnfortunately the time slot you requested ({{ $('Extract Booking Details').item.json.requestedStart }} - {{ $('Extract Booking Details').item.json.requestedEnd }}) is already booked.\n\nPlease choose a different time and submit the form again.\n\nSorry for the inconvenience!",
        "options": {}
      },
      "id": "a1f55817-1529-48a2-b286-e11878f67868",
      "name": "Send Rejection Email",
